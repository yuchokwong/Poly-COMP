# Copy to .env and edit. Values here override configs/default.yaml.
# Nested keys use a double underscore, e.g. APP__PORT -> app.port

# --- Public domain (docker-compose.prod.yml + Caddy automatic HTTPS) ---
# Point an A record for this domain at the server's public IP first.
DOMAIN=search.example.com
ACME_EMAIL=you@example.com

TSR_APP__HOST=0.0.0.0
TSR_APP__PORT=8000
TSR_APP__DEFAULT_TOP_K=12

# Model (OpenCLIP)
TSR_MODEL__NAME=ViT-B-32
TSR_MODEL__PRETRAINED=laion2b_s34b_b79k
TSR_MODEL__DEVICE=auto
TSR_MODEL__BATCH_SIZE=64

# Gallery
TSR_GALLERY__MAX_IMAGES=10000
TSR_GALLERY__IMAGE_MAX_SIDE=256
TSR_GALLERY__IMAGE_QUALITY=85

# Index: flat | ivf | hnsw
TSR_INDEX__TYPE=flat

# Search
TSR_SEARCH__HYBRID=false
TSR_SEARCH__USE_PROMPT_ENSEMBLE=false

# Docker build: choose the torch wheel index (CPU by default)
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
